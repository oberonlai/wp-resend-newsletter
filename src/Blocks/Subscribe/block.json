{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "wp-resend-newsletter/subscribe",
	"version": "0.1.0",
	"title": "Newsletter Subscribe",
	"category": "widgets",
	"icon": "email-alt",
	"description": "Double opt-in newsletter subscribe form (WP Resend Newsletter).",
	"keywords": [ "newsletter", "subscribe", "email", "resend" ],
	"textdomain": "wp-resend-newsletter",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"buttonLabel": {
			"type": "string",
			"default": ""
		},
		"description": {
			"type": "string",
			"default": ""
		},
		"showMedia": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "wprn-subscribe-editor",
	"viewScript": "wprn-subscribe-view",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
